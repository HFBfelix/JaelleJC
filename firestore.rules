rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FONCTION : Vérifie si l'utilisateur est un admin actif
    function estAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/autorisations/$(request.auth.token.email)).data.actif == true;
    }

    // WHITELIST : Lecture autorisée pour la vérification pré-connexion
    match /autorisations/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // PRODUITS : Lecture publique, écriture réservée à l'admin
    match /produits/{produitId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // BLOG : Lecture publique, écriture admin
    match /articles_blog/{articleId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // CATÉGORIES : Lecture publique (utilisée par Layout), écriture admin
    match /categories/{catId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // COMMANDES : Création par utilisateurs connectés, gestion admin
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update, delete: if estAdmin();
    }

    // PROFILS UTILISATEURS : Lecture/écriture par le propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function texte(v, max) {
      return v is string && v.size() <= max;
    }
    function emailValide(v) {
      return texte(v, 254) && v.matches('^[^@\\s<>]+@[^@\\s<>]+\\.[^@\\s<>]+$');
    }

    // NEWSLETTER : création publique validée (champs des formulaires du site), lecture admin
    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'subscribedAt', 'createdAt'])
                    && emailValide(request.resource.data.email)
                    && request.resource.data.source in ['footer_site', 'email_redirect']
                    && request.resource.data.get('subscribedAt', request.time) == request.time
                    && request.resource.data.get('createdAt', request.time) == request.time;
      allow read, delete: if estAdmin();
    }

    // CONTACTS : création publique validée (champs de Contact.tsx), lecture admin
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status'])
                    && request.resource.data.keys().hasAll(['email', 'message', 'createdAt'])
                    && texte(request.resource.data.get('name', ''), 100)
                    && emailValide(request.resource.data.email)
                    && texte(request.resource.data.get('subject', ''), 100)
                    && texte(request.resource.data.message, 5000)
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.get('status', 'unread') == 'unread';
      allow read, delete: if estAdmin();
    }

    // PARAMÈTRES : Lecture publique, écriture admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Sécurité par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
