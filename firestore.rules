rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // FONCTION CENTRALE : vérifie si l'email connecté est admin
    // Utilisée par dashboard.html ET les Cloud Functions côté client
    // ─────────────────────────────────────────────────────────
    function estAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && get(/databases/$(database)/documents/autorisations/$(request.auth.token.email)).data.actif == true;
    }

    // ─────────────────────────────────────────────────────────
    // COLLECTION : autorisations
    // Sert de whitelist. ID du document = adresse email exacte.
    // Structure requise : { actif: true, role: "admin" }
    // ─────────────────────────────────────────────────────────
    match /autorisations/{emailDoc} {
      // Lecture par document autorisée SANS authentification
      // → index.html peut vérifier l'email AVANT d'envoyer le lien magique
      allow get: if true;

      // On ne peut pas lister tous les admins ni modifier la whitelist via le web
      allow list: if false;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // COLLECTION : produits
    // Lecture publique pour le site vitrine.
    // Écriture réservée aux admins whitelistés (dashboard.html).
    // L'Admin SDK (Cloud Functions) contourne ces règles automatiquement.
    // ─────────────────────────────────────────────────────────
    match /produits/{produitId} {
      allow read: if true;
      allow create: if estAdmin();
      allow update: if estAdmin();
      allow delete: if estAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // COLLECTION : articles_blog
    // Lecture publique pour le site vitrine.
    // Écriture uniquement via Cloud Functions (Admin SDK) — pas depuis le web.
    // ─────────────────────────────────────────────────────────
    match /articles_blog/{articleId} {
      allow read: if true;
      allow write: if false; // L'agent Cloud Function écrit via Admin SDK, contourne cette règle
    }

    // ─────────────────────────────────────────────────────────
    // COLLECTION : commandes
    // Les clients peuvent créer une commande.
    // Seul l'Admin SDK (ton agent) peut lire/modifier.
    // ─────────────────────────────────────────────────────────
    match /commandes/{commandeId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // SÉCURITÉ PAR DÉFAUT : tout le reste est bloqué
    // ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
