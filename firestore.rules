rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FONCTION : Vérifie si l'utilisateur est un admin actif
    function estAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && get(/databases/$(database)/documents/autorisations/$(request.auth.token.email)).data.actif == true;
    }

    // WHITELIST : Lecture autorisée pour la vérification pré-connexion
    match /autorisations/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // PRODUITS : Lecture publique, écriture réservée à l'admin
    match /produits/{produitId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // BLOG : Lecture publique, écriture admin
    match /articles_blog/{articleId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // CATÉGORIES : Lecture publique (utilisée par Layout), écriture admin
    match /categories/{catId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // COMMANDES : Création par utilisateurs connectés, gestion admin
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update, delete: if estAdmin();
    }

    // PROFILS UTILISATEURS : Lecture/écriture par le propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // NEWSLETTER : Création publique, lecture admin
    match /newsletter/{id} {
      allow create: if true;
      allow read, delete: if estAdmin();
    }

    // CONTACTS : Création publique, lecture admin
    match /contacts/{contactId} {
      allow create: if true;
      allow read, delete: if estAdmin();
    }

    // PARAMÈTRES : Lecture publique, écriture admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Sécurité par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
