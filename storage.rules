rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────
    // DOSSIER : produits/
    // Contient les photos uploadées depuis dashboard.html
    // ─────────────────────────────────────────────────────────
    match /produits/{allPaths=**} {
      // Lecture publique — le site vitrine affiche les photos
      allow read: if true;

      // Écriture depuis le navigateur :
      // → L'utilisateur doit être connecté (auth != null)
      // → Son email doit être vérifié (email_verified)
      // → Taille max 10 Mo par fichier
      // → Uniquement des images
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Suppressions depuis le dashboard
      allow delete: if request.auth != null
                    && request.auth.token.email_verified == true;
    }

    // ─────────────────────────────────────────────────────────
    // SÉCURITÉ PAR DÉFAUT : tout le reste est bloqué
    // ─────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
