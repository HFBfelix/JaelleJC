rules_version = '2';

// Règles Storage de la refonte (étape 1bis). Administratrice = revendication `admin: true`
// (plus de lecture croisée de la collection `autorisations`).
service firebase.storage {
  match /b/{bucket}/o {

    function estAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Photos produits : lecture publique ; envoi d'images (JPEG, PNG, WebP, < 10 Mo) et suppression par l'admin.
    match /produits/{allPaths=**} {
      allow read: if true;
      allow create, update: if estAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if estAdmin();
    }

    // Tout le reste est refusé.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
